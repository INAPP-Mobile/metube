# MeTube — environment variables
#
# MeTube needs no secrets and no setup: the deploy form is empty. Copy this
# file to .env only if you run the image outside Railway. Every variable
# below is optional; the image defaults are the Railway deployment values.

# Port the web UI listens on. Railway injects PORT automatically; the
# upstream default is 8081 when PORT is unset.
PORT=8081

# Where downloads are saved. On Railway this is the persistent volume.
DOWNLOAD_DIR=/downloads

# Where audio-only downloads are saved (defaults to DOWNLOAD_DIR).
AUDIO_DOWNLOAD_DIR=/downloads

# Where files are written while downloading (defaults to DOWNLOAD_DIR).
TEMP_DIR=/downloads

# Where MeTube keeps its queue, history, subscriptions and uploaded
# cookies (defaults to DOWNLOAD_DIR/.metube).
STATE_DIR=/downloads/.metube

# Downloads that run at once; the rest wait their turn.
MAX_CONCURRENT_DOWNLOADS=3

# Serve browsable listings of the download directories (false = direct
# file links only, which is the safer default for a public URL).
DOWNLOAD_DIRS_INDEXABLE=false

# Show a Download Folder field under Advanced Options, to save into a
# subfolder of the download directory.
CUSTOM_DIRS=true

# Default UI theme: light, dark, or auto (follow the system).
DEFAULT_THEME=auto

# Options for every download, as a JSON object (yt-dlp options).
# Example: YTDL_OPTIONS={"format":"bestvideo[height<=1080]+bestaudio/best"}
YTDL_OPTIONS={}

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL or NONE.
LOGLEVEL=INFO
